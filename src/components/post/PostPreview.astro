---
import type { Post } from "@/types"

import { Card, CardHeader, CardTitle } from "@/components/ui/card"

import DateTime from "../date-time"
import { UserAvatar } from "../user/user-avatar"
import PostFooter from "./post-footer"

// Interpolates between two RGB colors based on a factor (0-1)
const interpolateColor = (
  start: { r: number; g: number; b: number },
  end: { r: number; g: number; b: number },
  factor: number
) => {
  const r = Math.round(start.r + (end.r - start.r) * factor)
  const g = Math.round(start.g + (end.g - start.g) * factor)
  const b = Math.round(start.b + (end.b - start.b) * factor)

  return `rgb(${r}, ${g}, ${b})`
}

// Determines the color for comment count display
const commentsColor = () => {
  const max = 6
  const value = post.comments.length

  const gray = { r: 113, g: 113, b: 122 } // #71717a
  const orange = { r: 254, g: 122, b: 21 } // #fe7a15

  if (value <= 1) return `rgb(${gray.r}, ${gray.g}, ${gray.b})`

  const ratio = Math.min(value / max, 1)

  return interpolateColor(gray, orange, ratio)
}

export interface Props {
  post: Post
}

const { post } = Astro.props
---

<a href={`/t/${post.slug}/${post.topic_id}`}>
  <Card className="flex items-center justify-between">
    <div class="flex items-center">
      <UserAvatar
        title={post.user.username}
        user={post.user}
        width={250}
        height={250}
        className="ml-6 hidden sm:block"
      />
      <CardHeader className="pr-2 sm:pr-4">
        <CardTitle className="text-base">{post.title}</CardTitle>
        <PostFooter category_id={post.category_id} tags={post.tags} />
      </CardHeader>
    </div>
    <div class="flex flex-col items-end pr-6">
      <span
        class="font-medium"
        style={{
          color: commentsColor(),
        }}
      >
        {post.comments.length}
      </span>
      <DateTime client:only="react" time={post.created_at} mode="short" />
    </div>
  </Card>
</a>
